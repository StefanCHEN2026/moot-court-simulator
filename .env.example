# ============================================================
# 环境变量示例 — 复制为 .env.local 后填写
#   cp .env.example .env.local
#
# 注意：也可直接在「设置」页面（/settings）配置大模型与法律检索 MCP。
# 优先级为：设置页面（data/settings.json）> 环境变量 > 内置默认值。
# 页面上留空的字段会回退到这里的环境变量。
# ============================================================

# ---------- 大模型（必需）----------
# 任意兼容 OpenAI /chat/completions 协议的服务均可：
#   DeepSeek  https://api.deepseek.com/v1
#   OpenAI    https://api.openai.com/v1
#   Moonshot  https://api.moonshot.cn/v1
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama http://localhost:11434/v1（API Key 可随便填）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 多模态（识图）模型，用于分析上传的图片证据。
# 留空则图片证据可以上传、展示，但不会自动生成 AI 识图分析。
LLM_VISION_MODEL=

# 单次请求超时（毫秒），默认 60000
LLM_TIMEOUT_MS=60000

# ---------- 出站地址安全（SSRF 防护）----------
# 默认拒绝把模型/MCP 地址指向本机与内网（localhost、127.0.0.1、10.x、
# 192.168.x、169.254.x 等），因为接口默认无鉴权，否则任何能访问本服务的
# 人都可把请求引向你的内网。
# 如果确实要用本地模型（Ollama、本地 vLLM 等）或本地 MCP，需显式放行：
ALLOW_PRIVATE_ENDPOINTS=false

# ---------- 文件存储（可选，默认本地磁盘）----------
# 上传的图片证据与案件文档的保存目录，默认 ./data/uploads
UPLOAD_DIR=

# 开庭次数统计文件，默认 ./data/stats.json
STATS_FILE=

# ---------- 法规数据（可选）----------
# 法规 JSON 目录，默认 ./data/laws
# 详见 data/laws/README.md
LAWS_DATA_DIR=

# ---------- 服务端口（可选）----------
# 开发/生产服务器端口，默认 5000
PORT=5000
